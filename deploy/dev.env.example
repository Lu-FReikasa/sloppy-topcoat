# Copy to deploy/dev.env (gitignored) and change the values.
# Used by `make dev` (docker compose) and `make hub-run` (native).

# Postgres password for the dev database container.
TOPCOAT_DB_PASSWORD=change-me

# Static dev admin token for the GUI/REST API (dev only; OIDC replaces it in stage 5).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The hub refuses to start with this example value or a token shorter than 32 characters.
TOPCOAT_DEV_ADMIN_TOKEN=change-me-too

# TLS (ARCHITECTURE D11). auto = the hub creates its own CA and certificate.
# List every name / IP the nodes and browsers use to reach the hub, comma-separated.
TOPCOAT_TLS_HOSTNAMES=hub.example.lan,10.0.0.x
# Other modes: files (TOPCOAT_TLS_CERT_FILE, TOPCOAT_TLS_KEY_FILE, optional TOPCOAT_TLS_CA_FILE)
# or off (only behind a reverse proxy that terminates TLS; then set TOPCOAT_PUBLIC_URL).
TOPCOAT_TLS_MODE=auto
TOPCOAT_PUBLIC_URL=

# For `make hub-run` outside docker (Postgres from `make db` on localhost).
TOPCOAT_DATABASE_URL=postgresql+psycopg://topcoat:change-me@localhost:5432/topcoat
