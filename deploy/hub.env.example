# Copy to deploy/hub.env (gitignored) and change the values. Used by deploy/docker-compose.yml.

# Postgres password (generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))").
TOPCOAT_DB_PASSWORD=change-me

# Static admin token for the GUI until OIDC login (stage 5).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOPCOAT_DEV_ADMIN_TOKEN=change-me-too

# Every name and IP nodes and browsers use to reach this machine, comma-separated.
TOPCOAT_TLS_HOSTNAMES=hub.example.lan,10.0.0.x

# auto (hub-managed CA, default) | files (own certificate) | off (behind a TLS reverse proxy)
TOPCOAT_TLS_MODE=auto
# files mode, paths inside the container (deploy/certs is mounted at /certs):
TOPCOAT_TLS_CERT_FILE=
TOPCOAT_TLS_KEY_FILE=
TOPCOAT_TLS_CA_FILE=
# URL shown in pairing commands when a reverse proxy is in front (mode off), e.g.
# https://topcoat.example.lan
TOPCOAT_PUBLIC_URL=

# Image to run; default is the channel "test" built from main.
# TOPCOAT_IMAGE=ghcr.io/lu-freikasa/sloppy-topcoat-hub:test

# Chat and gateway (E2-01): the model used for work that no model role covers (an admin changes it
# in the GUI). WHICH NODE AND MODEL do which work is not set here: the roles (answer, check with
# tools, background work, second look) are lists on the page "Models and roles". The variables
# that used to do it (TOPCOAT_CHAT_NODE_CHAIN, TOPCOAT_GATEWAY_NODE_ORDER,
# TOPCOAT_GATEWAY_BACKGROUND_NODES, TOPCOAT_GATEWAY_BACKGROUND_MODEL, TOPCOAT_MEMORY_MODEL,
# TOPCOAT_REVIEW_MODEL) are read once at start and turned into rows of the table; remove them afterwards.

# --- Memory (E2-02) ---
# Embedding model served through the gateway (bge-m3 after E2-03). Empty: the transitional
# hashing embedder (no model needed; finds shared words, not meaning).
TOPCOAT_EMBEDDING_MODEL=
# Seconds between consolidation checks (0 = only when started in the GUI); runs only while a
# node is available. The node's queue serves chat first and takes background work as soon as
# nothing more important is left; TOPCOAT_MEMORY_IDLE_SECONDS above 0 adds a quiet time after
# the last chat answer (0 = none).
TOPCOAT_MEMORY_CONSOLIDATION_INTERVAL_SECONDS=1800
TOPCOAT_MEMORY_IDLE_SECONDS=0

# --- Agent (E3-01e) ---
# Context (of ONE slot) the hub asks a node to load a model with for the agent and for a chat
# with tools, when the node's own config gives less (or nothing: 8192). 0 = do not ask.
TOPCOAT_AGENT_MIN_CONTEXT=16384
# A chat check is offered only the tool groups its question names (docker, journal, github ...)
# plus Topcoat, notes and host facts; a question without a clear topic keeps every tool.
# TOPCOAT_AGENT_AUTO_TOOL_GROUPS=true

# --- Redaction ---
# The hub sends no data to an external model (the escalation was removed). The redaction layer
# still keeps private names out of web search queries and hand-over summaries: your own public
# domains (comma-separated) are treated like private names (.lan, .local, .home.arpa ...) and every
# node name.
TOPCOAT_REDACT_DOMAINS=

# --- Knowledge base (E2-03) ---
# Extra exclude globs (comma-separated) on top of the fixed list (*SENSIBEL*, *ZUGANGSDATEN*,
# *.key, *.pem, *.env, *password*, *secret* …), matched against every file and folder name.
TOPCOAT_KNOWLEDGE_EXCLUDE=
# Seconds between automatic re-indexing of every source (0 = only when started in the GUI).
TOPCOAT_KNOWLEDGE_REINDEX_SECONDS=21600

# Time zone of the hub (log times, hour of the nightly memory care). Default: Europe/Berlin.
# Stored timestamps stay UTC. Needs a hub image built with this change (tzdata).
# TOPCOAT_TZ=Europe/Berlin

# One continuous conversation (user area), off by default. A segment ends after this many idle
# seconds; the next question then starts from a hand-over summary instead of the old messages.
# TOPCOAT_MAIN_THREAD_ENABLED=false
# TOPCOAT_SEGMENT_IDLE_SECONDS=1200

# GitHub (read-only tool of the assistant, admins only): there is nothing to set here. Add each
# repository with its own fine-grained token on the Repositories page of the GUI.

# Changes the user confirms with one click (restart buttons, the dev workshop's push). Off by default.
# TOPCOAT_PROPOSALS_ENABLED=true

# Signed update channel for the nodes (E2-06, ARCHITECTURE D50). The hub only stores and serves the
# builds that `topcoat-sign` uploaded; the nodes verify them. The directory is the hub-updates volume.
# TOPCOAT_UPDATE_DIR=/data/updates
# The public key(s) the builds are signed with (base64, comma-separated, at most two). Optional: with
# it the hub also refuses an upload that no key signed. Nodes always check against their own keys.
# TOPCOAT_UPDATE_PUBKEYS=

# --- Second look ---
# Every answer is read by another model right after it is given; what it finds reaches the chat's
# next answer, and an error with evidence makes the agent speak up. false = only when a chat rests.
TOPCOAT_REVIEW_AFTER_ANSWER=true
# A second model (the "second look" role, normally on the slow node) reads the agent's draft BEFORE
# it is delivered when the task used one of these tools (comma separated, empty = off). It is slow
# on purpose; a reviewer that does not answer in time only leaves a remark.
TOPCOAT_REVIEW_BEFORE_ANSWER_TOOLS=repo.test_start,repo.apply_patch
TOPCOAT_PRECHECK_TIMEOUT_SECONDS=240

# the hub's time zone (IANA name): the taskbar clock, "today" and quiet hours of everyone who chose none
TOPCOAT_HUB_TIMEZONE=Europe/Berlin
