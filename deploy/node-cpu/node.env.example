# Copy to node.env and fill in. Never commit node.env.
# Name of the node as the hub shows it.
TOPCOAT_NODE_NAME=node-cpu
# Needed for the FIRST start only (then the node is paired and keeps its own key in the volume).
TOPCOAT_HUB_URL=https://hub.example.lan:8443
# One-time code: hub GUI, "add node". It expires, create it right before the first start.
TOPCOAT_PAIR_CODE=
# Fingerprint of the hub CA, shown next to the code in the same place.
TOPCOAT_CA_FINGERPRINT=sha256:
# Optional: a host folder for the node data (key, runtime, models) instead of a Docker volume.
# TOPCOAT_NODE_DATA=/mnt/user/appdata/topcoat-node
# Optional: memory limit of the container.
# TOPCOAT_NODE_MEM_LIMIT=4g
