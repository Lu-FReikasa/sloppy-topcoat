{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topcoat:agents/outputs/decompose",
  "title": "A large task cut into sub-tasks that form a DAG (D109, issue #31)",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "store",
              "api",
              "gui",
              "proto",
              "docs",
              "admin",
              "research"
            ]
          },
          "files": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accept": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "goal",
          "layer",
          "files",
          "symbols",
          "new_files",
          "accept",
          "depends_on"
        ]
      }
    }
  },
  "required": [
    "summary",
    "subtasks"
  ]
}
