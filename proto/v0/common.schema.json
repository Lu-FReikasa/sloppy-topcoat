{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloppy-topcoat.example/proto/v0/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "node_state": {
      "type": "string",
      "enum": [
        "available",
        "busy_gaming",
        "degraded",
        "yielded"
      ],
      "description": "State reported by the node. 'yielded' = models were unloaded because other programs needed the memory (E1-06). 'offline' is hub-side only and never sent."
    },
    "error_code": {
      "type": "string",
      "enum": [
        "not_allowed",
        "invalid_args",
        "not_implemented",
        "runner_error",
        "busy",
        "timeout",
        "node_offline",
        "upgrade_required",
        "invalid_message",
        "internal",
        "not_loaded"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "vendor",
        "vram_total_mb"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string",
          "enum": [
            "nvidia",
            "amd",
            "intel",
            "other"
          ]
        },
        "vram_total_mb": {
          "type": "integer",
          "minimum": 0
        },
        "integrated": {
          "type": "boolean",
          "description": "iGPU / APU sharing system memory"
        },
        "shared_total_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "system memory the GPU may use (reported separately from dedicated VRAM)"
        }
      }
    },
    "gpu_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "vram_used_mb"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "vram_used_mb": {
          "type": "integer",
          "minimum": 0
        },
        "shared_used_mb": {
          "type": "integer",
          "minimum": 0
        },
        "foreign_vram_used_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "VRAM used by other programs (all usage minus this node's model processes), when known"
        },
        "foreign_gpu_util": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "GPU utilisation of other programs in percent, when known"
        },
        "foreign_shared_max_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "largest shared (system) GPU memory use of a single other program, when known: an application that did not fit into VRAM (E1-06 unmet demand)"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "A model available on the node's disk / in the runner catalogue.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string",
          "description": "e.g. gguf, mlx"
        }
      }
    },
    "loaded_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vram_used_mb": {
          "type": "integer",
          "minimum": 0
        },
        "context_length": {
          "type": "integer",
          "minimum": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "loopback port of the llama-server process"
        },
        "backend": {
          "$ref": "#/$defs/backend"
        },
        "ram_used_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "measured resident memory of the process"
        }
      }
    },
    "runner_type": {
      "type": "string",
      "enum": [
        "llamaserver",
        "fake"
      ]
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "type": "string",
      "enum": [
        "cuda",
        "vulkan",
        "cpu"
      ],
      "description": "llama.cpp backend of a node-managed build"
    }
  }
}
