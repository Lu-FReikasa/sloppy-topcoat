{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloppy-topcoat.example/proto/v0/event.schema.json",
  "title": "event",
  "description": "Direction: node -> hub.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "event"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "model_loaded",
            "model_unloaded",
            "game_detected",
            "game_ended",
            "download_progress",
            "state_changed",
            "error",
            "benchmark_started",
            "benchmark_result",
            "benchmark_finished",
            "runtime_installed",
            "auto_reload_paused"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
