{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloppy-topcoat.example/proto/v0/pair_request.schema.json",
  "title": "POST /api/node/pair request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "os",
    "arch",
    "public_key"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}-[A-Z0-9]{4}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "os": {
      "type": "string",
      "enum": [
        "windows",
        "linux"
      ]
    },
    "arch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "public_key": {
      "type": "string",
      "description": "ed25519 public key, base64 (std, padded)",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "agent_version": {
      "type": "string"
    }
  }
}
