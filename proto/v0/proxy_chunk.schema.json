{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloppy-topcoat.example/proto/v0/proxy_chunk.schema.json",
  "title": "proxy_chunk",
  "description": "Direction: node -> hub. Part of the upstream response, in order. The first chunk carries the upstream status and content type.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "proxy_chunk"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "seq",
        "data"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "format": "uuid",
          "description": "chosen by the hub, unique per request"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string",
          "maxLength": 90000,
          "contentEncoding": "base64",
          "description": "base64 of the bytes (at most 64 KiB per message)"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
