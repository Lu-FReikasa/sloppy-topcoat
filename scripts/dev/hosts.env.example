# Copy to .dev/hosts.env (gitignored). The scripts in scripts/dev read it themselves.
# Real addresses never go into the repository.
TOPCOAT_CI_HOST=user@node-nvidia.example.lan      # Linux machine with Docker: tests, lint, builds
TOPCOAT_OVERLAY_HOST=user@hub.example.lan         # the hub host: overlay deploy, live scripts
TOPCOAT_DEVNODE_HOST=user@dev-node.example.lan     # dev node: the live commit goes into its workshop (push-live-to-devnode.sh)
# the node the live state questions name (scripts/dev/live_cases.py; on the hub host: export it)
TOPCOAT_LIVE_NODE=node-nvidia
